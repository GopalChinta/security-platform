{
  "name": "security-management-platform-root",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Full-Stack Multi-Tenant Security Management Platform",
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "test": "npm run test --prefix backend",
    "test:coverage": "npm run test:coverage --prefix backend",
    "db:generate": "npm run db:generate --prefix backend",
    "db:migrate": "npm run db:migrate --prefix backend",
    "db:seed": "npm run db:seed --prefix backend",
    "db:setup": "npm run db:setup --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
